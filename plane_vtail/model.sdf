<?xml version="1.0" ?>
<!--
  Plane V-Tail SDF Model (mini_talon_vtail reference airframe)
  Architecture: Pattern B (Plugins embedded in model.sdf)
  Per spec in plane_sdf_architecture_spec.md
-->
<sdf version="1.9">
  <model name="plane_vtail">
    <pose>0 0 0 0 0 0</pose>

    <!-- Base Link: Fuselage & Primary Mass -->
    <link name="base_link">
      <pose>0 0 0 0 0 0</pose>
      <inertial>
        <pose>0 0 0 0 0 0</pose>
        <mass>1.8</mass>
        <inertia>
          <ixx>0.024607948</ixx>
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyy>0.086155637</iyy>
          <iyz>0</iyz>
          <izz>0.103828985</izz>
        </inertia>
      </inertial>

      <!-- Collision Geometries -->
      <collision name="fuselage_collision">
        <pose>0 0 0 0 0 0</pose>
        <geometry>
          <mesh>
            <uri>file:///home/sisir/gz_models/plane_vtail/meshes/mini_talon_fuselage_collision.stl</uri>
          </mesh>
        </geometry>
      </collision>

      <collision name="left_wing_collision">
        <pose>0 0 0 0 0 0</pose>
        <geometry>
          <mesh>
            <uri>file:///home/sisir/gz_models/plane_vtail/meshes/mini_talon_left_wing_collision.stl</uri>
          </mesh>
        </geometry>
      </collision>

      <collision name="right_wing_collision">
        <pose>0 0 0 0 0 0</pose>
        <geometry>
          <mesh>
            <uri>file:///home/sisir/gz_models/plane_vtail/meshes/mini_talon_right_wing_collision.stl</uri>
          </mesh>
        </geometry>
      </collision>

      <collision name="left_tail_collision">
        <pose>0 0 0 0 0 0</pose>
        <geometry>
          <mesh>
            <uri>file:///home/sisir/gz_models/plane_vtail/meshes/mini_talon_left_tail_collision.stl</uri>
          </mesh>
        </geometry>
      </collision>

      <collision name="right_tail_collision">
        <pose>0 0 0 0 0 0</pose>
        <geometry>
          <mesh>
            <uri>file:///home/sisir/gz_models/plane_vtail/meshes/mini_talon_right_tail_collision.stl</uri>
          </mesh>
        </geometry>
      </collision>

      <!-- Visual Representations -->
      <visual name="fuselage_visual">
        <pose>0 0 0 0 0 0</pose>
        <geometry>
          <mesh>
            <uri>file:///home/sisir/gz_models/plane_vtail/meshes/mini_talon_fuselage.dae</uri>
          </mesh>
        </geometry>
      </visual>

      <visual name="fuselage_logos_visual">
        <pose>0 0 0 0 0 0</pose>
        <geometry>
          <mesh>
            <uri>file:///home/sisir/gz_models/plane_vtail/meshes/mini_talon_fuselage_logos.dae</uri>
          </mesh>
        </geometry>
      </visual>

      <visual name="forward_deck_visual">
        <pose>0 0 0 0 0 0</pose>
        <geometry>
          <mesh>
            <uri>file:///home/sisir/gz_models/plane_vtail/meshes/mini_talon_forward_deck.dae</uri>
          </mesh>
        </geometry>
      </visual>

      <visual name="left_wing_visual">
        <pose>0 0 0 0 0 0</pose>
        <geometry>
          <mesh>
            <uri>file:///home/sisir/gz_models/plane_vtail/meshes/mini_talon_left_wing.dae</uri>
          </mesh>
        </geometry>
      </visual>

      <visual name="left_wing_logo_visual">
        <pose>0 0 0 0 0 0</pose>
        <geometry>
          <mesh>
            <uri>file:///home/sisir/gz_models/plane_vtail/meshes/mini_talon_left_wing_logo.dae</uri>
          </mesh>
        </geometry>
      </visual>

      <visual name="right_wing_visual">
        <pose>0 0 0 0 0 0</pose>
        <geometry>
          <mesh>
            <uri>file:///home/sisir/gz_models/plane_vtail/meshes/mini_talon_right_wing.dae</uri>
          </mesh>
        </geometry>
      </visual>

      <visual name="left_tail_visual">
        <pose>0 0 0 0 0 0</pose>
        <geometry>
          <mesh>
            <uri>file:///home/sisir/gz_models/plane_vtail/meshes/mini_talon_left_tail.dae</uri>
          </mesh>
        </geometry>
      </visual>

      <visual name="right_tail_visual">
        <pose>0 0 0 0 0 0</pose>
        <geometry>
          <mesh>
            <uri>file:///home/sisir/gz_models/plane_vtail/meshes/mini_talon_right_tail.dae</uri>
          </mesh>
        </geometry>
      </visual>

      <!-- Sensors embedded in base_link (matching x3_uav sensor pattern) -->
      <sensor name="imu_sensor" type="imu">
        <gz_frame_id>plane_vtail/base_link</gz_frame_id>
        <topic>imu</topic>
        <always_on>1</always_on>
        <update_rate>1000.0</update_rate>
      </sensor>

      <sensor name="air_pressure_sensor" type="air_pressure">
        <topic>air_pressure</topic>
        <always_on>1</always_on>
        <update_rate>30</update_rate>
      </sensor>

      <sensor name="magnetometer_sensor" type="magnetometer">
        <topic>magnetometer</topic>
        <always_on>1</always_on>
        <update_rate>30</update_rate>
      </sensor>

      <sensor name="navsat_sensor" type="navsat">
        <topic>navsat</topic>
        <always_on>1</always_on>
        <update_rate>30</update_rate>
      </sensor>
    </link>

    <!-- Main Wheel Link & Joint -->
    <link name="main_wheel_link">
      <pose>-0.05 0 -0.1 0 0 0</pose>
      <inertial>
        <mass>0.02</mass>
        <inertia>
          <ixx>1e-05</ixx>
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyy>1e-05</iyy>
          <iyz>0</iyz>
          <izz>1e-05</izz>
        </inertia>
      </inertial>
      <collision name="main_wheel_collision">
        <pose>0 0 0 1.570796 0 0</pose>
        <geometry>
          <mesh>
            <uri>file:///home/sisir/gz_models/plane_vtail/meshes/mini_talon_main_wheel_collision.stl</uri>
          </mesh>
        </geometry>
      </collision>
      <visual name="main_wheel_visual">
        <pose>0 0 0 1.570796 0 0</pose>
        <geometry>
          <mesh>
            <uri>file:///home/sisir/gz_models/plane_vtail/meshes/mini_talon_main_wheel.dae</uri>
          </mesh>
        </geometry>
      </visual>
    </link>
    <joint name="main_wheel_joint" type="revolute">
      <parent>base_link</parent>
      <child>main_wheel_link</child>
      <axis>
        <xyz>0 1 0</xyz>
        <limit>
          <lower>-1e16</lower>
          <upper>1e16</upper>
        </limit>
      </axis>
    </joint>

    <!-- Left Aileron Link & Joint -->
    <link name="left_aileron_link">
      <pose>-0.085 0.37 0.015 0 0 0</pose>
      <inertial>
        <mass>0.01</mass>
        <inertia>
          <ixx>1e-06</ixx>
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyy>1e-06</iyy>
          <iyz>0</iyz>
          <izz>1e-06</izz>
        </inertia>
      </inertial>
      <visual name="left_aileron_visual">
        <pose>-0.02 0 0 0 0 0</pose>
        <geometry>
          <mesh>
            <uri>file:///home/sisir/gz_models/plane_vtail/meshes/mini_talon_left_aileron.dae</uri>
          </mesh>
        </geometry>
      </visual>
    </link>
    <joint name="left_aileron_joint" type="revolute">
      <parent>base_link</parent>
      <child>left_aileron_link</child>
      <axis>
        <xyz>0 1 0</xyz>
        <limit>
          <lower>-0.523599</lower>
          <upper>0.523599</upper>
        </limit>
      </axis>
    </joint>

    <!-- Right Aileron Link & Joint -->
    <link name="right_aileron_link">
      <pose>-0.085 -0.37 0.015 0 0 0</pose>
      <inertial>
        <mass>0.01</mass>
        <inertia>
          <ixx>1e-06</ixx>
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyy>1e-06</iyy>
          <iyz>0</iyz>
          <izz>1e-06</izz>
        </inertia>
      </inertial>
      <visual name="right_aileron_visual">
        <pose>-0.02 0 0 0 0 0</pose>
        <geometry>
          <mesh>
            <uri>file:///home/sisir/gz_models/plane_vtail/meshes/mini_talon_right_aileron.dae</uri>
          </mesh>
        </geometry>
      </visual>
    </link>
    <joint name="right_aileron_joint" type="revolute">
      <parent>base_link</parent>
      <child>right_aileron_link</child>
      <axis>
        <xyz>0 1 0</xyz>
        <limit>
          <lower>-0.523599</lower>
          <upper>0.523599</upper>
        </limit>
      </axis>
    </joint>

    <!-- Left Ruddervator Link & Joint -->
    <link name="left_ruddervator_link">
      <pose>-0.345 0.075 0.05 0.785398 -0.30 0</pose>
      <inertial>
        <mass>0.005</mass>
        <inertia>
          <ixx>1e-06</ixx>
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyy>1e-06</iyy>
          <iyz>0</iyz>
          <izz>1e-06</izz>
        </inertia>
      </inertial>
      <visual name="left_ruddervator_visual">
        <pose>-0.02 0 0 0 0 0</pose>
        <geometry>
          <mesh>
            <uri>file:///home/sisir/gz_models/plane_vtail/meshes/mini_talon_left_ruddervator.dae</uri>
          </mesh>
        </geometry>
      </visual>
    </link>
    <joint name="left_ruddervator_joint" type="revolute">
      <parent>base_link</parent>
      <child>left_ruddervator_link</child>
      <axis>
        <xyz>0 1 0</xyz>
        <limit>
          <lower>-0.523599</lower>
          <upper>0.523599</upper>
        </limit>
      </axis>
    </joint>

    <!-- Right Ruddervator Link & Joint -->
    <link name="right_ruddervator_link">
      <pose>-0.345 -0.075 0.05 -0.785398 -0.30 0</pose>
      <inertial>
        <mass>0.005</mass>
        <inertia>
          <ixx>1e-06</ixx>
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyy>1e-06</iyy>
          <iyz>0</iyz>
          <izz>1e-06</izz>
        </inertia>
      </inertial>
      <visual name="right_ruddervator_visual">
        <pose>-0.02 0 0 0 0 0</pose>
        <geometry>
          <mesh>
            <uri>file:///home/sisir/gz_models/plane_vtail/meshes/mini_talon_right_ruddervator.dae</uri>
          </mesh>
        </geometry>
      </visual>
    </link>
    <joint name="right_ruddervator_joint" type="revolute">
      <parent>base_link</parent>
      <child>right_ruddervator_link</child>
      <axis>
        <xyz>0 1 0</xyz>
        <limit>
          <lower>-0.523599</lower>
          <upper>0.523599</upper>
        </limit>
      </axis>
    </joint>

    <!-- Motor Link & Joint (Pusher Prop) -->
    <link name="motor_link">
      <pose>-0.45 0 0.029 0 0 0</pose>
      <inertial>
        <mass>0.05</mass>
        <inertia>
          <ixx>1e-05</ixx>
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyy>1e-05</iyy>
          <iyz>0</iyz>
          <izz>1e-05</izz>
        </inertia>
      </inertial>
      <visual name="motor_prop_visual">
        <pose>0 0 0 0 1.570796 0</pose>
        <geometry>
          <mesh>
            <uri>file:///home/sisir/gz_models/plane_vtail/meshes/iris_prop_cw.dae</uri>
          </mesh>
        </geometry>
      </visual>
    </link>
    <joint name="motor_joint" type="revolute">
      <parent>base_link</parent>
      <child>motor_link</child>
      <axis>
        <xyz>1 0 0</xyz>
        <limit>
          <lower>-1e16</lower>
          <upper>1e16</upper>
        </limit>
      </axis>
    </joint>

    <!-- ==================== PLUGINS (Pattern B) ==================== -->

    <!-- Joint State Publisher -->
    <plugin
      filename="gz-sim-joint-state-publisher-system"
      name="gz::sim::systems::JointStatePublisher">
    </plugin>

    <!-- Joint Position Controllers for Control Surfaces -->
    <plugin
      filename="gz-sim-joint-position-controller-system"
      name="gz::sim::systems::JointPositionController">
      <joint_name>left_aileron_joint</joint_name>
      <topic>/left_aileron_joint/cmd_pos</topic>
      <p_gain>10.0</p_gain>
      <i_gain>0.0</i_gain>
      <d_gain>0.0</d_gain>
      <i_max>0.0</i_max>
      <i_min>0.0</i_min>
      <cmd_max>0.523599</cmd_max>
      <cmd_min>-0.523599</cmd_min>
    </plugin>

    <plugin
      filename="gz-sim-joint-position-controller-system"
      name="gz::sim::systems::JointPositionController">
      <joint_name>right_aileron_joint</joint_name>
      <topic>/right_aileron_joint/cmd_pos</topic>
      <p_gain>10.0</p_gain>
      <i_gain>0.0</i_gain>
      <d_gain>0.0</d_gain>
      <i_max>0.0</i_max>
      <i_min>0.0</i_min>
      <cmd_max>0.523599</cmd_max>
      <cmd_min>-0.523599</cmd_min>
    </plugin>

    <plugin
      filename="gz-sim-joint-position-controller-system"
      name="gz::sim::systems::JointPositionController">
      <joint_name>left_ruddervator_joint</joint_name>
      <topic>/left_ruddervator_joint/cmd_pos</topic>
      <p_gain>10.0</p_gain>
      <i_gain>0.0</i_gain>
      <d_gain>0.0</d_gain>
      <i_max>0.0</i_max>
      <i_min>0.0</i_min>
      <cmd_max>0.523599</cmd_max>
      <cmd_min>-0.523599</cmd_min>
    </plugin>

    <plugin
      filename="gz-sim-joint-position-controller-system"
      name="gz::sim::systems::JointPositionController">
      <joint_name>right_ruddervator_joint</joint_name>
      <topic>/right_ruddervator_joint/cmd_pos</topic>
      <p_gain>10.0</p_gain>
      <i_gain>0.0</i_gain>
      <d_gain>0.0</d_gain>
      <i_max>0.0</i_max>
      <i_min>0.0</i_min>
      <cmd_max>0.523599</cmd_max>
      <cmd_min>-0.523599</cmd_min>
    </plugin>

    <!-- Aerodynamic LiftDrag Plugins for Wings and V-Tail Panels -->
    <plugin
      filename="gz-sim-lift-drag-system"
      name="gz::sim::systems::LiftDrag">
      <a0>0.13</a0>
      <cla>3.7</cla>
      <cda>0.06417112299</cda>
      <cma>0.0</cma>
      <alpha_stall>0.3391428111</alpha_stall>
      <cla_stall>-3.85</cla_stall>
      <cda_stall>-0.9233984055</cda_stall>
      <cma_stall>0.0</cma_stall>
      <cp>0 0.27 0.029</cp>
      <area>0.16</area>
      <air_density>1.225</air_density>
      <forward>1 0 0</forward>
      <upward>0 0 1</upward>
      <link_name>base_link</link_name>
      <control_joint_name>left_aileron_joint</control_joint_name>
      <control_joint_rad_to_cl>-0.75</control_joint_rad_to_cl>
    </plugin>

    <plugin
      filename="gz-sim-lift-drag-system"
      name="gz::sim::systems::LiftDrag">
      <a0>0.13</a0>
      <cla>3.7</cla>
      <cda>0.06417112299</cda>
      <cma>0.0</cma>
      <alpha_stall>0.3391428111</alpha_stall>
      <cla_stall>-3.85</cla_stall>
      <cda_stall>-0.9233984055</cda_stall>
      <cma_stall>0.0</cma_stall>
      <cp>0 -0.27 0.029</cp>
      <area>0.16</area>
      <air_density>1.225</air_density>
      <forward>1 0 0</forward>
      <upward>0 0 1</upward>
      <link_name>base_link</link_name>
      <control_joint_name>right_aileron_joint</control_joint_name>
      <control_joint_rad_to_cl>-0.75</control_joint_rad_to_cl>
    </plugin>

    <plugin
      filename="gz-sim-lift-drag-system"
      name="gz::sim::systems::LiftDrag">
      <a0>0.13</a0>
      <cla>3.7</cla>
      <cda>0.06417112299</cda>
      <cma>0.0</cma>
      <alpha_stall>0.3391428111</alpha_stall>
      <cla_stall>-3.85</cla_stall>
      <cda_stall>-0.9233984055</cda_stall>
      <cma_stall>0.0</cma_stall>
      <cp>-0.33 0.08 0.051</cp>
      <area>0.025</area>
      <air_density>1.225</air_density>
      <forward>1 0 0</forward>
      <upward>0 1 1</upward>
      <link_name>base_link</link_name>
      <control_joint_name>left_ruddervator_joint</control_joint_name>
      <control_joint_rad_to_cl>-2.0</control_joint_rad_to_cl>
    </plugin>

    <plugin
      filename="gz-sim-lift-drag-system"
      name="gz::sim::systems::LiftDrag">
      <a0>0.13</a0>
      <cla>3.7</cla>
      <cda>0.06417112299</cda>
      <cma>0.0</cma>
      <alpha_stall>0.3391428111</alpha_stall>
      <cla_stall>-3.85</cla_stall>
      <cda_stall>-0.9233984055</cda_stall>
      <cma_stall>0.0</cma_stall>
      <cp>-0.33 -0.08 0.051</cp>
      <area>0.025</area>
      <air_density>1.225</air_density>
      <forward>1 0 0</forward>
      <upward>0 -1 1</upward>
      <link_name>base_link</link_name>
      <control_joint_name>right_ruddervator_joint</control_joint_name>
      <control_joint_rad_to_cl>-2.0</control_joint_rad_to_cl>
    </plugin>

    <!-- Propulsion Thruster Plugin (Force-Direct Mode) -->
    <plugin
      filename="gz-sim-thruster-system"
      name="gz::sim::systems::Thruster">
      <joint_name>motor_joint</joint_name>
      <fluid_density>1.225</fluid_density>
      <use_angvel_cmd>false</use_angvel_cmd>
      <max_thrust_cmd>20.0</max_thrust_cmd>
      <min_thrust_cmd>0.0</min_thrust_cmd>
      <topic>cmd_thrust</topic>
    </plugin>

  </model>
</sdf>
